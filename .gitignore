node_modules/
dist/
# 服务端接口实现的 esbuild 产物（npm run build:server 生成）
server-build/

# 运行时产物：图片 / 视频 / 配音 / 成片 / 字幕临时文件
public/generated/
public/videos/
public/voices/
public/exports/

# 密钥与本地配置
.env
.env.*
!.env.example
*.key
*.pem
keys.json

# 本地设置/项目数据库（含 API Key）
projects/*.sqlite
projects/*.sqlite-wal
projects/*.sqlite-shm

# 系统与编辑器
.DS_Store
__pycache__/
*.log
.idea/

# 本机工具配置（openspec CLI 生成、ZCode 本地指针、视频插件绝对路径）
.zcode/
.video_agent/

# 项目数据（工作台读写的真相源，按项目入库、产物不入库）
projects/*/project.json.bak
projects/*/assets/
projects/*/*-backup-*.json
# 删除项目前的数据库快照：本地可手工恢复，不随仓库分发
.deleted/

# 临时基准脚本
bench*.mjs

# 沙箱运行时构建产物（由 scripts/build-sandbox-runtime.mjs 生成）
src/sandbox/runtime.generated.js

# 验证脚本自起的临时项目目录
.verify-*/

# Agent 作业目录（运行期临时产物，作业结束即失效）
.agent-jobs/

# 临时探针脚本目录（排查用，随手创建）
.probe*/

# 根目录遗留的本地数据库（含项目数据，不入库）
storyboard.sqlite
storyboard.sqlite-shm
storyboard.sqlite-wal

# 项目素材产物：任何层级的 assets 目录都不入库（project.json 仍入库）
projects/**/assets/

# Blender 渲染作业的临时目录（成功/失败/取消后自动清理）
.blender-jobs/
.vggt-jobs/

# Agent 场景草稿的临时目录（会话结束/启动时清理）
.scene-drafts/

# 创意会话的源视频与证据帧（本地素材，不随仓库分发；会话记录仍在 projects/*.sqlite）
creatives/

# 发布：本机 Chrome profile（含登录态）与离线发布包
.publish-profiles/
public/publish-packages/

# 部署：本机数据目录、DTK 源码与运行期密钥
data/
.dtk/
deploy/proxy/.htpasswd
# 部署目标与 SSH 凭据（deploy.sh 加载，含明文密码）
deploy/.deploy.conf

# 部署证书（只放目标机）
deploy/ssl/

# 压缩包验收夹具：7.4MB 的第三方素材，不入库。
# verify-bundle-import.mjs 在缺夹具时会自动从 /tmp/cat-probe 现场打包。
fixtures/*.zip

# 桌面端：打包产物与随包二进制（体积大，构建时下载）
desktop/dist/
desktop/bin/
