node_modules/
dist/

# 运行时产物：图片 / 视频 / 配音 / 成片 / 字幕临时文件
public/generated/
public/videos/
public/voices/
public/exports/

# 密钥与本地配置
.env
.env.*
!.env.example
*.key
*.pem
keys.json

# 本地设置/项目数据库（含 API Key）
projects/*.sqlite
projects/*.sqlite-wal
projects/*.sqlite-shm

# 系统与编辑器
.DS_Store
__pycache__/
*.log

# 项目数据（工作台读写的真相源，按项目入库、产物不入库）
projects/*/project.json.bak
projects/*/assets/

# 临时基准脚本
bench*.mjs

# 沙箱运行时构建产物（由 scripts/build-sandbox-runtime.mjs 生成）
src/sandbox/runtime.generated.js

# 验证脚本自起的临时项目目录
.verify-*/
