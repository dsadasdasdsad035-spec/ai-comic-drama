# 构建上下文排除：镜像里不该出现本机数据、产物与密钥
node_modules
dist
.git
.gitignore
.idea
.DS_Store

# 业务数据与产物（挂卷，不进镜像）
projects/
data/
creatives/
out/
public/generated/
public/videos/
public/voices/
public/exports/

# 本地密钥与配置
.env
.env.*
!.env.example
*.key
*.pem
keys.json

# 本机工具与临时目录
.zcode
.video_agent
.dtk
.blender-jobs
.scene-drafts
.publish-profiles
.verify-*
bench*.mjs
*.log

# 反向代理口令文件（只在目标机生成）
deploy/proxy/.htpasswd

# 验证脚本与证据（不是运行时依赖）
verify-*.mjs
audit-ui.mjs
qc.mjs
shot-inspector.mjs
openspec/changes/**/evidence/
fixtures/
tests/

# 证书只挂进代理容器，不进应用镜像
deploy/ssl/
