# 分镜画布部署配置
#
# 复制成仓库根目录的 .env 再改：  cp deploy/.env.example .env
# 这个文件只放「部署时才知道」的值；模型、音色、创意绑定等仍在设置页里配。

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------

# 访问地址。默认只绑回环；要局域网访问改成 0.0.0.0（同时请自行加认证或反代）
APP_BIND_ADDR=127.0.0.1
APP_PORT=5273

# ---------------------------------------------------------------------------
# 渠道 Key（留空 = 该渠道不可用，不会回退到别的渠道）
# ---------------------------------------------------------------------------

# 标准方舟：Seedream 出图 / Seedance 出片
ARK_API_KEY=
# 字节方舟 Agent Plan：文本 + 图片（ark- 前缀的 Key 只认 /api/plan）
ARK_AGENT_PLAN_API_KEY=
# APIMart：文本 / 图像 / 视频 / TTS（网关 api.apimart.ai/v1）
# 平台代调用扣用户积分时必填；用户若在设置里填了自有 Key 则不计费
APIMART_API_KEY=
# 同 APIMART_API_KEY，二选一
APIB_API_KEY=
# MiniMax：文本 + 配音（默认渠道）
MINIMAX_API_KEY=
# 可选：ElevenLabs 配音、火山 TTS、Sync Labs 口型
ELEVENLABS_API_KEY=
VOLC_TTS_API_KEY=
SYNC_LABS_API_KEY=

# ---------------------------------------------------------------------------
# 平台计费（虎皮椒 + 用户钱包，见 docs/billing.md）
# ---------------------------------------------------------------------------

# 计费 SQLite 路径（默认 data/billing.sqlite）
# BILLING_DB_PATH=

# 计费管理员：可开关 billing_enabled、查看对账
BILLING_ADMIN_EMAIL=

# 虎皮椒商户（未配置时充值 API 返回 503）
XUNHUPAY_APPID=
XUNHUPAY_SECRET=
XUNHUPAY_GATEWAY=https://api.xunhupay.com
# 必须公网 HTTPS，且指向本应用：…/api/billing/xunhupay/notify（勿填其它项目的域名）
XUNHUPAY_NOTIFY_URL=

# 仅本地/测试：管理员模拟入账（生产勿开）
# BILLING_ALLOW_SIMULATE=0

# 邮箱验证：console=链接打在服务端日志；生产需自行扩展 SMTP
# BILLING_EMAIL_DRIVER=console

# ---------------------------------------------------------------------------
# 创意摄取
# ---------------------------------------------------------------------------

# DTK（Douyin_TikTok_Download_API）：抖音/TikTok 的可行路径。
# scripts/dtk-up.sh 会打印出实际地址与 Key，把它们填到这里。
# 若 DTK 与应用都在宿主机 Docker 上，用 host.docker.internal 而不是 127.0.0.1。
DTK_BASE_URL=
DTK_API_KEY=

# yt-dlp 读哪个浏览器的 cookies（chrome / safari / edge / firefox；留空不读）。
# 容器内没有浏览器时留空；本机开发时可用 chrome。
YTDLP_COOKIES_FROM_BROWSER=

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------

# 本机装了 Blender 才填；容器默认不装，3D 渲染入口会显示不可用
BLENDER_BIN=

# 出图/出片单次超时（毫秒）
SEEDREAM_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# DTK 自身（只被 scripts/dtk-up.sh 使用，应用不需要读）
# ---------------------------------------------------------------------------

# 固定版本，避免上游改动把部署打挂
DTK_REF=0661234

# DTK 发布的宿主机端口
DTK_PORT=8000

# 首次初始化用的管理员账号（建完即失效，token 一次性）
DTK_ADMIN_USER=admin
DTK_ADMIN_PASSWORD=change-me-please-8chars