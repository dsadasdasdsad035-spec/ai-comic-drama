{
  "name": "storyboard-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/app.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server-build/app.mjs",
    "prestart": "npm run build:server",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "desktop:prep": "npm run build && node desktop/scripts/fetch-runtime.mjs",
    "desktop:dev": "electron .",
    "desktop:build": "npm run desktop:prep && electron-builder --config desktop/electron-builder.yml --dir",
    "desktop:dist": "npm run desktop:prep && electron-builder --config desktop/electron-builder.yml --mac dmg",
    "desktop:dmg": "npm run desktop:prep && CSC_IDENTITY_AUTO_DISCOVERY=false SKIP_NOTARIZE=1 electron-builder --config desktop/electron-builder.yml --mac dmg",
    "verify:billing": "node verify-billing-all.mjs",
    "verify:billing:e2e": "node verify-billing-e2e-smoke.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.30",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xyflow/react": "^12.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "konva": "^9.3.20",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
