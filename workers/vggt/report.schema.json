{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-comic-drama.local/schemas/vggt-report-v1.json",
  "title": "VGGTReferenceReportV1",
  "type": "object",
  "required": [
    "version",
    "sourceFingerprint",
    "probe",
    "confidence",
    "keyframes",
    "motionSummaryZh",
    "mappingNote",
    "warnings"
  ],
  "properties": {
    "version": { "const": 1 },
    "sourceFingerprint": { "type": "string", "minLength": 8 },
    "probe": {
      "type": "object",
      "required": ["duration", "width", "height", "fps"],
      "properties": {
        "duration": { "type": ["number", "null"] },
        "width": { "type": ["number", "null"] },
        "height": { "type": ["number", "null"] },
        "fps": { "type": ["number", "null"] }
      }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "scaleHint": {
      "type": "object",
      "properties": {
        "unit": { "type": "string" },
        "sceneExtentM": { "type": ["number", "null"] },
        "note": { "type": "string" }
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "position", "rotationQuat", "fovDeg", "confidence"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "rotationQuat": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "fovDeg": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "motionSummaryZh": { "type": "string", "minLength": 1 },
    "mappingNote": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "sampleCount": { "type": "integer", "minimum": 1, "maximum": 48 }
  },
  "additionalProperties": true
}
